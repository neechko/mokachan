# ==================== DISCORD ====================
DISCORD_TOKEN=
CHANNEL_ID=

# ==================== BOT IDENTITY ====================
BOT_NAME=mokachan

# ==================== PREFIX ====================
# Prefix bisa "m" atau "M", dan berkat COMMAND_CASE_INSENSITIVE=true
# keduanya akan dikenali di SEMUA command (ai, lyrics, history, dst).
COMMAND_PREFIX=m
COMMAND_CASE_INSENSITIVE=true

# ==================== HISTORY / OUTPUT ====================
HISTORY_COUNT=5
TRIM_CHARS=700
MAX_OUTPUT_CHARS=1800

# ==================== GEMINI ====================
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.7-flash,dll,.
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_DELAY=500

# ==================== COMMAND NAMES ====================
CMD_MOKACHAN=mokachan
CMD_LYRICS=lyrics
CMD_HISTORY=history
CMD_CLEARHISTORY=clearhistory
CMD_STATS=stats
CMD_PING=ping
CMD_HELP=help
CMD_CLAIM=claim
CMD_KOLEKSI=koleksi
CMD_PROFIL=profil
CMD_RESETCOMPANION=resetcompanion
CMD_SETSPAWNCHANNEL=setspawnchannel


# ==================== COMPANION MEMORY (rolling summary) ====================
# ringkasan + fakta yang di-update sendiri oleh AI tiap N giliran.
SUMMARY_EVERY_N_TURNS=6
MAX_FACTS=8
AFFECTION_PER_TURN=1
PASSIVE_LEARN_BATCH_SIZE=12
PASSIVE_LEARN_MIN_LENGTH=4

# ==================== CLAIM KARAKTER (spawn ala Rimi-chan) ====================
# Karakter random dari AniList otomatis muncul di channel yang aktif
# chat, tiap CHARACTER_SPAWN_INTERVAL_MS. Kalau tidak ada yang klaim
# dalam CHARACTER_SPAWN_TIMEOUT_MS, spawn hangus.
CHARACTER_SPAWN_INTERVAL_MS=600000
CHARACTER_SPAWN_TIMEOUT_MS=300000

#disk management
HISTORY_RETAIN_COUNT=30
MAINTENANCE_INTERVAL_MS=21600000

CMD_DISKUSAGE=disk
CMD_VACUUMCONVERT=vacuum
# ==================== DISCORD ====================
DISCORD_TOKEN=
CHANNEL_ID=

# ==================== BOT IDENTITY ====================
BOT_NAME=mokachan

# ==================== PREFIX ====================
# Prefix bisa "m" atau "M", dan berkat COMMAND_CASE_INSENSITIVE=true
# keduanya akan dikenali di SEMUA command (ai, lyrics, history, dst).
COMMAND_PREFIX=m
COMMAND_CASE_INSENSITIVE=true

# ==================== HISTORY / OUTPUT ====================
HISTORY_COUNT=5
TRIM_CHARS=700
MAX_OUTPUT_CHARS=1800

# ==================== GEMINI ====================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash,dll,.
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_DELAY=2000

# ==================== COMMAND NAMES ====================
CMD_MOKACHAN=mokachan
CMD_LYRICS=lyrics
CMD_HISTORY=history
CMD_CLEARHISTORY=clearhistory
CMD_STATS=stats
CMD_PING=ping
CMD_HELP=help
